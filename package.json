{
  "name": "crystal-launcher",
  "version": "2.3.0",
  "description": "Crystal Launcher - offline Minecraft launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "ai.crystal.launcher",
    "productName": "Crystal Launcher",
    "copyright": "Crystal Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "ui/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Crystal Launcher",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Crystal-Launcher-Setup-${version}.${ext}",
      "allowElevation": true,
      "uninstallDisplayName": "Crystal Launcher",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}